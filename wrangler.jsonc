{
  // Cloudflare Workers config: serves this folder as a static site, no build step.
  "name": "adamaboatieh",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },
  // The site answers on both addresses; the workers.dev address is switched off.
  "routes": [
    { "pattern": "adamaboatieh.com", "custom_domain": true },
    { "pattern": "www.adamaboatieh.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
